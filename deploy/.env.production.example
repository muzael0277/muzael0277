# ─────────────────────────────────────────────────────────────────────────────
# Production environment for a single VPS.
#
#   cp deploy/.env.production.example deploy/.env.production
#   bash deploy/gen-secrets.sh        # fills the three blank secrets below
#
# Never commit the filled-in file. `deploy/.env.production` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info

# ── Domains ──────────────────────────────────────────────────────────────────
# All four must point at this server's IP with an A record before you run
# init-letsencrypt.sh, or the certificate request fails.
DOMAIN=example.uz
ADMIN_DOMAIN=admin.example.uz
MINIAPP_DOMAIN=app.example.uz
API_DOMAIN=api.example.uz

# Where Let's Encrypt sends expiry warnings. A real address you read.
CERTBOT_EMAIL=you@example.uz

# ── Public URLs (derived from the domains above) ─────────────────────────────
WEB_URL=https://example.uz
ADMIN_URL=https://admin.example.uz
MINIAPP_URL=https://app.example.uz
API_PUBLIC_URL=https://api.example.uz
STORAGE_PUBLIC_URL=https://api.example.uz/files

# Baked into the browser bundle at build time, so it is the URL the browser
# calls — not a container name. Changing it means rebuilding, not restarting.
NEXT_PUBLIC_API_URL=https://api.example.uz/v1

# ── Database ─────────────────────────────────────────────────────────────────
# Not published to the host in production; only the compose network reaches it.
POSTGRES_USER=bizbot
POSTGRES_DB=bizbot
POSTGRES_PASSWORD=

# ── Secrets ──────────────────────────────────────────────────────────────────
# gen-secrets.sh fills these. Left blank on purpose: a placeholder that works
# is a placeholder that ships.
#
#   JWT_ACCESS_SECRET       openssl rand -base64 48
#   JWT_REFRESH_SECRET      openssl rand -base64 48   (must differ)
#   SECRETS_ENCRYPTION_KEY  openssl rand -hex 32
#
# SECRETS_ENCRYPTION_KEY is the one you cannot regenerate: lose it and every
# tenant's bot token and payment credentials become unreadable. Back it up
# somewhere other than the database backup.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SECRETS_ENCRYPTION_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_BASE_URL=https://api.example.uz

# ── Behaviour ────────────────────────────────────────────────────────────────
ENABLE_DEMO_MODE=false
ENABLE_SWAGGER=false
RATE_LIMIT_ENABLED=true
RUN_WORKER_IN_API=false
WORKER_CONCURRENCY=5
