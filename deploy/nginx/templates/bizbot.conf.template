# ─────────────────────────────────────────────────────────────────────────────
# BizBot OS — reverse proxy.
#
# ${VARS} are substituted at container start by the official nginx entrypoint,
# which only substitutes names that exist in the environment — nginx's own
# $host, $remote_addr and friends are left alone.
# ─────────────────────────────────────────────────────────────────────────────

# The real client address, for rate limiting and audit logs. Without it every
# request looks like it came from the proxy, and one abusive client throttles
# everyone.
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 10.0.0.0/8;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header Upgrade           $http_upgrade;
proxy_set_header Connection        $connection_upgrade;

client_max_body_size 20m;

# ── HTTP: ACME challenge, everything else to HTTPS ───────────────────────────
server {
  # IPv4 only. Add `listen [::]:80;` and `listen [::]:443 ssl;` if the server has
  # IPv6 — nginx refuses to start on an address family the host does not have,
  # and that failure looks like a broken config rather than a missing interface.
  listen 80;
  server_name ${DOMAIN} ${ADMIN_DOMAIN} ${MINIAPP_DOMAIN} ${API_DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# ── API ──────────────────────────────────────────────────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name ${API_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  # Payment webhook signatures are computed over the exact bytes received.
  # Nothing here may rewrite, re-encode or re-serialize a request body: a proxy
  # that "tidies" JSON invalidates every Click and Payme callback.
  proxy_request_buffering on;

  location / {
    proxy_pass http://api:4000;
    proxy_read_timeout 60s;
  }

  # Uploaded files, served by the API with the local storage driver.
  location /files/ {
    proxy_pass http://api:4000;
    proxy_cache_valid 200 1h;
    add_header Cache-Control "public, max-age=3600";
  }
}

# ── Admin dashboard ──────────────────────────────────────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name ${ADMIN_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${ADMIN_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${ADMIN_DOMAIN}/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  # Staff tooling is never legitimately framed, so deny it outright.
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    proxy_pass http://admin:3000;
  }
}

# ── Telegram Mini App ────────────────────────────────────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name ${MINIAPP_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${MINIAPP_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${MINIAPP_DOMAIN}/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  # No X-Frame-Options here, deliberately. Telegram opens a Mini App inside its
  # own webview, and a blanket DENY leaves every customer looking at a blank
  # window with nothing in the logs to explain it.
  add_header X-Content-Type-Options "nosniff" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    proxy_pass http://miniapp:3000;
  }
}

# ── Public website ───────────────────────────────────────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN} www.${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  add_header X-Content-Type-Options "nosniff" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    proxy_pass http://web:3000;
  }
}
