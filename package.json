{
  "name": "bizbot-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm format:check && pnpm typecheck",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:invariants": "pnpm --filter @bizbot/api test:invariants",
    "db:generate": "pnpm --filter @bizbot/database generate",
    "db:migrate": "pnpm --filter @bizbot/database migrate",
    "db:push": "pnpm --filter @bizbot/database push",
    "db:seed": "pnpm --filter @bizbot/database seed",
    "db:reset": "pnpm --filter @bizbot/database reset",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "setup:env": "node tools/link-env.mjs",
    "db:migrate:deploy": "pnpm --filter @bizbot/database migrate:deploy",
    "e2e:admin": "node tools/e2e-admin.mjs",
    "db:check": "pnpm --filter @bizbot/database check:integrity"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "1.49.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
