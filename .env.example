# ─────────────────────────────────────────────────────────────────────────────
# BizBot OS — environment
#
# Copy to .env and fill in. The application validates this file on boot and
# refuses to start on invalid configuration, so a typo fails immediately rather
# than at 3am (packages/config/src/env.ts).
#
# Never commit a filled-in .env. Real secrets belong in your host's secret store.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
API_GLOBAL_PREFIX=v1

# ── Surfaces (used for CORS and for links sent to customers) ─────────────────
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
MINIAPP_URL=http://localhost:3002

# ── Data ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bizbot?schema=public"
DATABASE_POOL_SIZE=10
REDIS_URL="redis://localhost:6379"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# The two JWT secrets must differ, so a leaked access key cannot mint refresh
# tokens. Production refuses values that look like development placeholders.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# AES-256-GCM key for tenant credentials (bot tokens, Click/Payme keys).
# Exactly 32 bytes: openssl rand -hex 32
# Losing this makes every stored integration credential unreadable.
SECRETS_ENCRYPTION_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────────
# polling  — local development; no public URL needed
# webhook  — production; TELEGRAM_WEBHOOK_BASE_URL must be public HTTPS
TELEGRAM_MODE=polling
TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_WEBHOOK_BASE_URL=https://api.yourdomain.uz

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_URL=http://localhost:4000/files
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Queues ───────────────────────────────────────────────────────────────────
QUEUE_PREFIX=bizbot
WORKER_CONCURRENCY=5
# Convenient locally; refused in production, where the worker runs as its own
# process so a slow job cannot stall HTTP.
RUN_WORKER_IN_API=true

# ── Behaviour ────────────────────────────────────────────────────────────────
ENABLE_DEMO_MODE=true
ENABLE_SWAGGER=true
RATE_LIMIT_ENABLED=true

# ── Frontends (build-time) ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
