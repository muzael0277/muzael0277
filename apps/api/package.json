{
  "name": "@bizbot/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "dev:worker": "tsx watch src/main.worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:invariants": "vitest run src/**/__tests__/*.invariant.spec.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@bizbot/config": "workspace:*",
    "@bizbot/contracts": "workspace:*",
    "@bizbot/database": "workspace:*",
    "@bizbot/i18n": "workspace:*",
    "@bizbot/payments": "workspace:*",
    "@bizbot/rbac": "workspace:*",
    "@bizbot/shared": "workspace:*",
    "@bizbot/telegram": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.6",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
